# 복사해서 .env로 저장한 뒤 값을 입력합니다. .env는 절대 커밋하지 않습니다(.gitignore에 포함).
# 주석은 반드시 별도 줄에 씁니다. 값 뒤에 주석을 붙이면 systemd·Docker env 파일에서 값의 일부로 읽힙니다.

# 실행 모드: paper | mock | real
TRADER_MODE=mock
# real 모드에서만, 충분한 모의투자 검증 후 주석을 해제합니다.
# TRADER_REAL_CONFIRM=I_UNDERSTAND_REAL_MONEY_RISK

# 한국투자증권 KIS Developers 앱키·시크릿(모의용과 실전용은 서로 다름)
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 형식: 12345678-01 (모의투자는 모의계좌번호)
KIS_ACCOUNT_NO=

# 금융감독원 OpenDART 인증키(국내 재무제표)
DART_API_KEY=
# 미국 SEC EDGAR 이용 시 필수: 이름 또는 회사명과 연락처 이메일
SEC_USER_AGENT=
# 민감 데이터 암호화 키: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TRADER_DATA_KEY=

TRADER_DATA_DIR=./var/data
TRADER_DB_PATH=./var/ledger.sqlite3
TRADER_REPORT_DIR=./var/reports
